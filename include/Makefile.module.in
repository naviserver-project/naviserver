#
# Makefile.module --
#
#     Makefile include for NaviServer modules, libraries, and programs.  Variables to set
#     before including this file include:
#
#     NAVISERVER  naviserver install directory.
#     MODNAME     Unique name of module
#     MOD         File name of binary loadable module
#     MODOBJS     List of module object files (required with MOD)
#     TCL         List of module shared Tcl files
#     TCL_INIT    Optional init.tcl template (@NS_MODULE_VERSION@, @NS_MODULE_TAG@)
#     TCL_INIT_FILE  Generated entry point (default init.tcl)
#     TCL_VERSION Optional metadata template (default version.tcl.in if present, Tcl modules only)
#     TCL_VERSION_FILE Generated metadata (default version.tcl)
#     VERSION_SVG Optional version badge template (default version.svg.in if present)
#     VERSION_SVG_FILE Generated badge (default .version.svg)
#     NS_MODULE_VERSION  Release version used by metadata and badge templates
#     NS_MODULE_TAG  Build tag (default git describe; archives retain recorded tag)
#     LIBNM       Root name of dynamic library (without lib prefix or extension)
#     LIBOBJS     List of library object files (required with LIBNM)
#     LIBHDRS     List of public header files to install (required with module LIBNM)
#     PGM         Name of executable program
#     PGMOBJS     List of program object files (required with PGM)
#     HDRS        Header files which objects depend on
#     MODLIBS     Extra module link libraries
#     LIBLIBS     Extra dynamic library link libraries
#     PGMLIBS     Extra program link libraries
#     INSTALL     Extra install directive(s)
#     CLEAN       Extra clean directive(s)
#     DESTDIR     Root directory for install
#     MODULE_CONFIG_PARAMETERS  Module-owned dictionary (doc/tcl/config-parameters.tcl)
#     MODULE_PARAMETER_INCLUDE  Committed doctools fragment (doc/src/include/parameters.man)
#     DOC_TOOLS   Installed/shared documentation tools, overridable for source development
#
#     At least one of PGM, MOD, LIBNM, TCL, or TCL_INIT must be defined.  For backwards compatibility,
#     MODOBJS will default to OBJS and MODINST can be used for module install.
#
#     For static builds (use configure --disable-shared) the LIBNM variable is
#     replaced with ALIB which triggers the linking of the static library.
#
#     See nsd/Makefile and nsdb/Makefile for examples.
#
#     Note that we do *not* use a variables named "LIB" or "INCLUDE",
#     because they would conflict with environment variables of the same
#     name needed by the Microsoft Windows compiler and/or linker.
#

uname = $(shell uname -a)

STATIC_BUILD = @STATIC_BUILD@

ifdef NSBUILD
    ifeq ($(STATIC_BUILD), 1)
        ALIB    := $(LIBNM)
        LIBNM   :=
    endif
    include ../include/Makefile.global
else
    include $(NAVISERVER)/include/Makefile.global
endif

#
# Compare with the numerical version of NaviServer. If the version
# test holds, nothing is installed. If "Version" is not found in the
# result of "nsd -V", this indicates an older version of NaviServer
# and the installation is performed.
#
# The numerical version is computed as
#
#   NS_MAJOR_VERSION * 10000 + NS_MINOR_VERSION * 100 + NS_RELEASE_SERIAL
#
# NaviServer 5.0.0 has the numerical value of 50000.
#
ifdef INCLUDED_IN_NAVISERVER
    V = $(shell $(NAVISERVER)/bin/nsd -V | grep "Version" | cut -d ":" -f 2)
    ifeq ($(shell test $(V) -ge $(INCLUDED_IN_NAVISERVER); echo $$?),0)
        $(info This module is already included in NaviServer $(INCLUDED_IN_NAVISERVER))
	TCL=
	MOD=
	LIBNM=
	ALIB=
	PGM=
	LIBHDRS=
    endif
endif

# Optional module-owned templates share one release version and build tag.
# Native/mixed modules retain metadata from Ns_ModuleGetInfo(); automatic Tcl
# metadata discovery is limited to modules without a binary component.
# Evaluate discovery immediately: ifdef tests the stored value, so a deferred
# wildcard expression would enable templates even when no matching file exists.
ifndef MOD
    ifeq ($(origin TCL_VERSION), undefined)
        TCL_VERSION := $(wildcard version.tcl.in)
    endif
endif
ifeq ($(origin VERSION_SVG), undefined)
    VERSION_SVG := $(wildcard version.svg.in)
endif

ifdef TCL_INIT
    TCL_INIT_FILE ?= init.tcl
    TCL += $(TCL_INIT_FILE)
    BUILD += $(TCL_INIT_FILE)
endif
ifdef TCL_VERSION
    TCL_VERSION_FILE ?= version.tcl
    TCL += $(TCL_VERSION_FILE)
    BUILD += $(TCL_VERSION_FILE)
endif
ifdef VERSION_SVG
    VERSION_SVG_FILE ?= .version.svg
    TCL += $(VERSION_SVG_FILE)
    BUILD += $(VERSION_SVG_FILE)
endif

ifneq ($(strip $(TCL_INIT)$(TCL_VERSION)$(VERSION_SVG)),)
    ifndef NS_MODULE_VERSION
        $(error NS_MODULE_VERSION not specified for module version templates)
    endif
    ifndef NS_MODULE_TAG
        NS_MODULE_TAG := $(shell git describe --abbrev=12 --always --dirty=+ 2>/dev/null \
            || sed -n -e 's/^ns_module tag {\(.*\)}$$/\1/p' \
                -e 's/^set [^ ]*::tag {\(.*\)}$$/\1/p' $(TCL_VERSION_FILE) $(TCL_INIT_FILE) 2>/dev/null)
        ifeq ($(strip $(NS_MODULE_TAG)),)
            NS_MODULE_TAG = unknown
        endif
    endif
endif

ifdef MOD
    ifeq (.exe,$(EXEEXT))
        MOD := $(shell basename $(MOD) .so)$(LIBEXT)
    endif

    BUILD     += $(MOD)
    INSTALL   += install-mod
    CLEAN     += clean-mod

    ifeq ($(origin MODOBJS), undefined)
        MODOBJS	= $(OBJS)
    endif

    MODOBJS   += $(UNIXOBJS)

    ifdef MODNAME
        ifndef NS_MODULE_TAG
            NS_MODULE_TAG := $(shell git describe --abbrev=12 --always \
			  --dirty=+ 2>/dev/null || echo unknown)
        endif

        MODULE_INFO_HEADER = .ns-module-info.h
        MODULE_INFO_FILES  = $(MODULE_INFO_HEADER) $(MODULE_INFO_HEADER).tmp
    endif
endif

ifdef TCL
    ifndef MODNAME
        $(error MODNAME not specified)
    endif
    INSTALL += install-tcl
endif

ifdef LIBNM
    LIBFILE	 = lib$(LIBNM)$(LIBEXT)
    BUILD   += $(LIBFILE)
    INSTALL += install-lib
    CLEAN   += clean-lib
    MODLIBS += $(LIBFILE)
    PGMLIBS += $(LIBFILE)
    LIBOBJS += $(UNIXOBJS)
endif

ifdef ALIB
    ALIBFILE  = lib$(ALIB).a
    BUILD    += $(ALIBFILE)
    INSTALL  += install-alib
    CLEAN    += clean-alib
    MODLIBS  += $(ALIBFILE)
    PGMLIBS  += $(ALIBFILE)
    LIBOBJS  += $(UNIXOBJS)
endif

ifdef PGM
    ifeq (.exe,$(EXEEXT))
	PGM := $(PGM)$(EXEEXT)
    endif
    BUILD   += $(PGM)
    INSTALL += install-pgm
    CLEAN   += clean-pgm
endif

ifdef LIBHDRS
    INSTALL += install-hdrs
endif

ifdef MODULE_INFO_HEADER
    CFLAGS += -include $(MODULE_INFO_HEADER)

    $(MODOBJS) $(LIBOBJS) $(PGMOBJS): $(MODULE_INFO_HEADER)
endif

# Install module-owned documentation metadata independently of rendered manuals.
MODULE_CONFIG_PARAMETERS ?= doc/tcl/config-parameters.tcl
ifneq ($(wildcard $(MODULE_CONFIG_PARAMETERS)),)
    INSTALL += install-config-parameters
endif

all build: $(BUILD)

# Generate only the templates a module supplies. Preserve timestamps when the
# expanded contents are unchanged, including builds from distribution archives.
ifdef TCL_INIT
$(TCL_INIT_FILE): $(TCL_INIT) FORCE_MODULE_INFO
	@sed -e 's|@NS_MODULE_VERSION@|$(NS_MODULE_VERSION)|g' \
	     -e 's|@NS_MODULE_TAG@|$(NS_MODULE_TAG)|g' $(TCL_INIT) > $@.tmp
	@if test -r $@ && cmp -s $@.tmp $@; then \
	    $(RM) $@.tmp; \
	else \
	    mv $@.tmp $@; \
	fi

install-tcl: $(TCL_INIT_FILE)
endif

ifdef TCL_VERSION
$(TCL_VERSION_FILE): $(TCL_VERSION) FORCE_MODULE_INFO
	@sed -e 's|@NS_MODULE_VERSION@|$(NS_MODULE_VERSION)|g' \
	     -e 's|@NS_MODULE_TAG@|$(NS_MODULE_TAG)|g' $(TCL_VERSION) > $@.tmp
	@if test -r $@ && cmp -s $@.tmp $@; then \
	    $(RM) $@.tmp; \
	else \
	    mv $@.tmp $@; \
	fi

install-tcl: $(TCL_VERSION_FILE)
endif

ifdef VERSION_SVG
$(VERSION_SVG_FILE): $(VERSION_SVG) FORCE_MODULE_INFO
	@sed -e 's|@NS_MODULE_VERSION@|$(NS_MODULE_VERSION)|g' \
	     -e 's|@NS_MODULE_TAG@|$(NS_MODULE_TAG)|g' $(VERSION_SVG) > $@.tmp
	@if test -r $@ && cmp -s $@.tmp $@; then \
	    $(RM) $@.tmp; \
	else \
	    mv $@.tmp $@; \
	fi

install-tcl: $(VERSION_SVG_FILE)
endif
ifdef MODULE_INFO_HEADER
$(MODULE_INFO_HEADER): FORCE_MODULE_INFO
	@{ \
	    echo '#define NS_MODULE_NAME "$(MODNAME)"'; \
	    echo '#define NS_MODULE_TAG "$(NS_MODULE_TAG)"'; \
	} > $(MODULE_INFO_HEADER).tmp
	@if test -r $(MODULE_INFO_HEADER) \
	    && cmp -s $(MODULE_INFO_HEADER).tmp $(MODULE_INFO_HEADER); then \
	    $(RM) $(MODULE_INFO_HEADER).tmp; \
	else \
	    mv $(MODULE_INFO_HEADER).tmp $(MODULE_INFO_HEADER); \
	fi
endif

FORCE_MODULE_INFO:

install: $(INSTALL)

clean: $(CLEAN)

$(MOD): $(LIBFILE) $(ALIBFILE) $(MODOBJS)
	$(RM) $(MOD)
	$(LDSO) $(LDFLAGS) -o $(MOD) $(MODOBJS) $(MODLIBS) $(NSLIBS) @LDRPATH@

$(LIBFILE): $(LIBOBJS)
	$(RM) $(LIBFILE)
	$(LDLIB) $(LDFLAGS) -o $(LIBFILE) $(LIBOBJS) $(LIBLIBS) $(NSLIBS) @LDRPATH@

$(ALIBFILE): $(LIBOBJS)
	$(AR) rv $(ALIBFILE) $(LIBOBJS)
	$(RANLIB) $(ALIBFILE)

$(PGM): $(PGMOBJS) $(LIBFILE) $(ALIBFILE)
	$(RM) $(PGM)
	$(CC) $(LDFLAGS) -o $(PGM) $(PGMOBJS) $(PGMLIBS) $(CCLIBS) @CCRPATH@

$(MODOBJS) $(LIBOBJS) $(PGMOBJS): $(HDRS) $(INCDIR)/ns.h $(INCDIR)/nsthread.h

install-mod: $(MOD) $(MODINST)
	$(INSTALL_SH) $(MOD) $(DESTDIR)$(INSTBIN)/

install-tcl: $(TCL)
	@$(MKDIR) $(DESTDIR)$(INSTTCL)/$(MODNAME)
	for t in $(TCL); do \
		$(INSTALL_DATA) $$t $(DESTDIR)$(INSTTCL)/$(MODNAME)/; \
	done

install-lib: $(LIBFILE)
    ifeq (.exe,$(EXEEXT))
		$(INSTALL_SH) $(LIBFILE) $(DESTDIR)$(INSTBIN)/
    else
		$(INSTALL_SH) $(LIBFILE) $(DESTDIR)$(INSTLIB)/
    endif

install-alib: $(ALIBFILE)
	$(INSTALL_SH) $(ALIBFILE) $(DESTDIR)$(INSTLIB)/
	$(RANLIB) $(ALIBFILE)

install-pgm: $(PGM)
	$(INSTALL_SH) $(PGM) $(DESTDIR)$(INSTBIN)/

install-hdrs: $(LIBHDRS)
	for h in $(LIBHDRS); do \
		$(INSTALL_DATA) $$h $(DESTDIR)$(INSTHDR)/; \
	done

clean-mod:
	$(RM) $(MOD) $(MODOBJS) $(MODULE_INFO_FILES)

clean-lib:
	$(RM) $(LIBFILE) $(LIBOBJS)

clean-alib:
	$(RM) $(ALIBFILE) $(LIBOBJS)

clean-pgm:
	$(RM) $(PGM) $(PGMOBJS)

cppcheck:
	cppcheck --verbose --force --enable=all $(CFLAGS_INCLUDE) *.c

.PHONY: clean-mod clean-lib clean-alib clean-pgm FORCE_MODULE_INFO

# Module-owned parameter documentation. Ordinary builds check only that the
# committed fragment exists; regeneration and rendering are explicit operations.
# Override DOC_TOOLS to use a NaviServer source checkout during development.
DOC_TOOLS ?= $(NAVISERVER)/share/naviserver/doc/tools
MODULE_CONFIG_PARAMETERS ?= doc/tcl/config-parameters.tcl
MODULE_PARAMETER_INCLUDE ?= doc/src/include/parameters.man
MODULE_DOC_HTML ?= doc/html
MODULE_DOC_MAN ?= doc/man

ifneq ($(wildcard $(MODULE_CONFIG_PARAMETERS)),)
    ifndef MODNAME
        $(error MODNAME is required for module parameter documentation)
    endif
    .PHONY: config-parameters-includes regen-config-parameters-includes check-config-parameters build-doc check-doc install-config-parameters
    all build: config-parameters-includes
    REGEN_CONFIG_PARAMETERS ?= 0
    ifeq ($(REGEN_CONFIG_PARAMETERS),1)
    config-parameters-includes: regen-config-parameters-includes
    else
    config-parameters-includes:
	@if test ! -r "$(MODULE_PARAMETER_INCLUDE)"; then \
	    echo "missing generated module parameter include: $(MODULE_PARAMETER_INCLUDE)"; \
	    echo "run make regen-config-parameters-includes"; exit 1; \
	fi
    endif
    regen-config-parameters-includes:
	$(TCLSH_PROG) "$(DOC_TOOLS)/gen-config-parameters.tcl" \
	    --config "$(MODULE_CONFIG_PARAMETERS)" --module "$(MODNAME)" --output "$(MODULE_PARAMETER_INCLUDE)"
    check-config-parameters:
	$(TCLSH_PROG) "$(DOC_TOOLS)/gen-config-parameters.tcl" \
	    --config "$(MODULE_CONFIG_PARAMETERS)" --module "$(MODNAME)" --output "$(MODULE_PARAMETER_INCLUDE)" --check
    build-doc: config-parameters-includes
	$(TCLSH_PROG) "$(DOC_TOOLS)/build-module-doc.tcl" --source "$(CURDIR)" \
	    --module "$(MODNAME)" --output "$(MODULE_DOC_HTML)" --format html
	$(TCLSH_PROG) "$(DOC_TOOLS)/build-module-doc.tcl" --source "$(CURDIR)" \
	    --module "$(MODNAME)" --output "$(MODULE_DOC_MAN)" --format nroff
    check-doc: check-config-parameters
	$(TCLSH_PROG) "$(DOC_TOOLS)/build-module-doc.tcl" --source "$(CURDIR)" \
	    --module "$(MODNAME)" --output "$(MODULE_DOC_HTML)" --format validate
    install-config-parameters: config-parameters-includes
	$(MKDIR) "$(DESTDIR)$(INSTTCL)/$(MODNAME)/doc/tcl"
	$(INSTALL_DATA) "$(MODULE_CONFIG_PARAMETERS)" "$(DESTDIR)$(INSTTCL)/$(MODNAME)/doc/tcl/config-parameters.tcl"
endif
