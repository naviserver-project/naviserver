# -*- Tcl -*-
package require tcltest 2.2
namespace import -force ::tcltest::*
::tcltest::configure {*}$argv

# Log assertions require enabled severities, including in worker threads.
source [file join [file dirname [info script]] quiet-logging.tcl]
if {[::tcltest::runQuietLoggingTests [info script] $argv]} {
    ::tcltest::cleanupTests
    return
}

testConstraint serverListen [expr {[ns_config test listenport] ne ""}]

namespace eval ::leadingCRLF {
    variable request "GET /__leading_crlf HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
}

proc ::leadingCRLF::setup {} {
    ns_register_proc GET /__leading_crlf {ns_return 200 text/plain OK}
    ns_register_proc POST /__leading_crlf {ns_return 200 text/plain [ns_conn content]}
}
proc ::leadingCRLF::cleanup {} {
    ns_unregister_op GET /__leading_crlf
    ns_unregister_op POST /__leading_crlf
}
proc ::leadingCRLF::connect {} {
    ns_connchan connect -timeout 2 [ns_config test loopback] [ns_config test listenport]
}
proc ::leadingCRLF::write {chan data} {
    set n [ns_connchan write $chan $data]
    if {$n != [string length $data]} {error "short write: $n"}
}
proc ::leadingCRLF::response {chan} {
    set data ""
    set end [expr {[clock milliseconds] + 5000}]
    while {1} {
        if {[clock milliseconds] > $end} {error "incomplete response: $data"}
        append data [ns_connchan read $chan]
        set boundary [string first "\r\n\r\n" $data]
        if {$boundary < 0} continue
        set headers [string range $data 0 [expr {$boundary-1}]]
        regexp {^HTTP/1\.[01] ([0-9]+)} $headers -> status
        # Driver-generated errors can omit Content-Length.
        if {$status == 400} {return [list $status {}]}
        if {![regexp -nocase {\r\ncontent-length: *([0-9]+)} $headers -> length]} {
            if {$status in {413 414}} {return [list $status {}]}
            error "missing Content-Length: $headers"
        }
        set body [string range $data [expr {$boundary+4}] end]
        if {[string length $body] >= $length} {
            if {[string length $body] != $length} {error "unexpected trailing response bytes"}
            return [list $status $body]
        }
    }
}
proc ::leadingCRLF::exchange {parts} {
    set chan [connect]
    try {
        set index 0
        foreach part $parts {
            write $chan $part
            # Exercise parser state across writes, including an incomplete CRLF.
            if {[incr index] < [llength $parts]} {ns_sleep 0.1}
        }
        response $chan
    } finally {
        ns_connchan close $chan
    }
}

foreach {suffix description prefix} {
    1 {no leading blank line} {}
    2 {one leading CRLF} {\r\n}
    3 {eight CRLFs at the limit} {\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n}
    4 {sixteen LFs at the limit} {\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n}
} {
    test driver-leading-crlf-1.$suffix $description -constraints serverListen \
        -setup {::leadingCRLF::setup} -body {
            ::leadingCRLF::exchange [list [subst -nocommands -novariables $prefix]$::leadingCRLF::request]
        } -cleanup {::leadingCRLF::cleanup} -result {200 OK}
}

test driver-leading-crlf-2.1 {CRLF split across reads; exact limit followed by GET} \
    -constraints serverListen -setup {::leadingCRLF::setup} -body {
        ::leadingCRLF::exchange [list "\r" "\n" [string repeat "\r\n" 7] $::leadingCRLF::request]
    } -cleanup {::leadingCRLF::cleanup} -result {200 OK}

foreach {suffix prefix} [list 1 [string repeat "\r\n" 9] 2 [string repeat "\n" 17]] {
    test driver-leading-crlf-3.$suffix {excess leading bytes rejected without waiting for GET} \
        -constraints serverListen -body {
            ::leadingCRLF::exchange [list $prefix]
        } -result {400 {}}
}

test driver-leading-crlf-3.3 {limit persists across reads} -constraints serverListen -body {
    ::leadingCRLF::exchange [list [string repeat "\r\n" 8] "\r\n"]
} -result {400 {}}

test driver-leading-crlf-4.1 {header terminator and CRLF in request body unchanged} \
    -constraints serverListen -setup {::leadingCRLF::setup} -body {
        ::leadingCRLF::exchange [list "POST /__leading_crlf HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\nConnection: close\r\n\r\n\r\nXY"]
    } -cleanup {::leadingCRLF::cleanup} -result [list 200 "\r\nXY"]

test driver-leading-crlf-4.2 {fresh limit after keep-alive response and trailing CRLF} \
    -constraints serverListen -setup {::leadingCRLF::setup} -body {
        set chan [::leadingCRLF::connect]
        try {
            set keep [string map {close keep-alive} $::leadingCRLF::request]
            ::leadingCRLF::write $chan [string repeat "\r\n" 8]$keep
            set first [::leadingCRLF::response $chan]
            ::leadingCRLF::write $chan "\r\n"
            ns_sleep 0.1
            ::leadingCRLF::write $chan [string repeat "\r\n" 7]$::leadingCRLF::request
            list $first [::leadingCRLF::response $chan]
        } finally {
            ns_connchan close $chan
        }
    } -cleanup {::leadingCRLF::cleanup} -result {{200 OK} {200 OK}}

test driver-leading-crlf-5.1 {excess prefix still produces one combined diagnostic per rejection} \
    -constraints serverListen -setup {
        set warningEnabled [ns_logctl severity Warning]
        ns_logctl severity Warning on
        nsv_set leading-crlf warnings {}
        set filter [ns_logctl register {apply {{severity timestamp message} {
            if {$severity eq "Warning" && [string first {invalid request: 400} $message] >= 0} {
                nsv_lappend leading-crlf warnings $message
            }
        }}}]
    } -body {
        set replies {}
        for {set i 0} {$i < 2} {incr i} {
            lappend replies [::leadingCRLF::exchange [list [string repeat "\n" 17]]]
        }
        set end [expr {[clock milliseconds]+2000}]
        while {[llength [nsv_get leading-crlf warnings]] < 2 && [clock milliseconds] < $end} {
            ns_sleep 0.01
        }
        set warnings [nsv_get leading-crlf warnings]
        set combined [expr {[llength $warnings] == 2}]
        foreach message $warnings {
            if {[string first {request '' offsets:} $message] < 0
                || [string first {; REQ BUFFER: } $message] < 0
                || [string first {\x0a\x0a} $message] < 0} {set combined 0}
        }
        list $replies $combined
    } -cleanup {
        ns_logctl unregister $filter
        ns_logctl severity Warning $warningEnabled
        nsv_unset -nocomplain leading-crlf
    } -result {{{400 {}} {400 {}}} 1}


foreach {suffix target headers body reason} {
    1 missing-slash {Host: localhost\r\n} {} {request target must start with a slash}
    2 {/bad\\separator} {Host: localhost\r\n} {} {target string contains invalid path separator}
    3 /missing-host {} {} {request header field "Host" is missing in HTTP/1.1 request}
    4 /duplicate-host {Host: localhost\r\nHost: localhost\r\n} {} {request header field "host" is provided more than once}
    5 /conflicting-framing {Host: localhost\r\nContent-Length: 0\r\nTransfer-Encoding: chunked\r\n} {} {both Content-Length and Transfer-Encoding are present}
    6 /unsupported-encoding {Host: localhost\r\nTransfer-Encoding: gzip\r\n} {} {invalid or unsupported Transfer-Encoding}
    7 /invalid-content-length {Host: localhost\r\nContent-Length: xyz\r\n} {} {invalid Content-Length}
    8 /invalid-expected-length {Host: localhost\r\nTransfer-Encoding: chunked\r\nX-Expected-Entity-Length: xyz\r\n} {} {invalid x-expected-entity-length}
    9 /invalid-chunk {Host: localhost\r\nTransfer-Encoding: chunked\r\n} {z\r\n} {ChunkedDecode: invalid chunk length}
    10 /invalid-chunk-suffix {Host: localhost\r\nTransfer-Encoding: chunked\r\n} {1z\r\n} {ChunkedDecode: invalid chunk length suffix}
    11 /invalid-chunk-end {Host: localhost\r\nTransfer-Encoding: chunked\r\n} {1\r\nabc} {ChunkedDecode: missing CRLF after chunk data}
    12 /invalid-url-%FF {Host: localhost\r\n} {} {invalid UTF-8 in request URL}
    13 {/invalid-url-\xff} {Host: localhost\r\n} {} {Invalid UTF-8 encoding in url}
    14 /negative-chunk {Host: localhost\r\nTransfer-Encoding: chunked\r\n} {-1\r\n} {ChunkedDecode: negative chunk length}
    15 /overflowing-chunk {Host: localhost\r\nTransfer-Encoding: chunked\r\n} {ffffffffffffffffffffffff\r\n} {ChunkedDecode: chunk length overflow}
} {
    test driver-bad-request-1.$suffix {malformed request emits one bounded diagnostic} \
        -constraints serverListen -setup {
            set warningEnabled [ns_logctl severity Warning]
            ns_logctl severity Warning on
            nsv_set requestDiagnostic warnings {}
            set filter [ns_logctl register {apply {{severity timestamp message} {
                if {$severity eq "Warning"
                    && [regexp {invalid request|cannot parse request line|request header field|invalid or unsupported Transfer-Encoding|invalid Content-Length|invalid x-expected-entity-length|ChunkedDecode|Invalid UTF-8 encoding in url|decoded string contains invalid UTF-8} $message]} {
                    nsv_lappend requestDiagnostic warnings $message
                }
            }}}]
        } -body {
            set padding [string repeat A 512]
            set headerLines [subst -nocommands -novariables $headers]
            set targetBytes [subst -nocommands -novariables $target]
            set bodyBytes [subst -nocommands -novariables $body]
            set reply [::leadingCRLF::exchange [list "GET $targetBytes HTTP/1.1\r\n${headerLines}X-Test: $padding\r\n\r\n$bodyBytes"]]
            set deadline [expr {[clock milliseconds] + 2000}]
            while {![regexp {invalid request: 400} [nsv_get requestDiagnostic warnings]]
                   && [clock milliseconds] < $deadline} {
                ns_sleep 10ms
            }
            set warnings [nsv_get requestDiagnostic warnings]
            set message [lindex $warnings 0]
            list $reply [llength $warnings] \
                [regexp {invalid request: 400 .* from peer (::1|127\.0\.0\.1):} $message] \
                [expr {[string first $reason $message] >= 0}] \
                [expr {[string first {\x0d\x0a} $message] >= 0}] \
                [expr {[string first [string repeat A 256] $message] < 0}]
        } -cleanup {
            ns_logctl unregister $filter
            ns_logctl severity Warning $warningEnabled
            nsv_unset -nocomplain requestDiagnostic
        } -result {{400 {}} 1 1 1 1 1}
}

foreach {suffix description rejected expected} {
    1 {accepted pre-HTTP/1.0 request retains its notice} 0 {OK 1 Notice 1}
    2 {rejected pre-HTTP/1.0 request reports one combined warning} 1 {{400 {}} 1 Warning 1}
} {
    test driver-legacy-request-1.$suffix $description -constraints serverListen -setup {
        set noticeEnabled [ns_logctl severity Notice]
        set warningEnabled [ns_logctl severity Warning]
        ns_logctl severity Notice on
        ns_logctl severity Warning on
        ::leadingCRLF::setup
        nsv_set legacyRequest diagnostics {}
        set filter [ns_logctl register {apply {{severity timestamp message} {
            if {$severity in {Notice Warning}
                && [string first {/__leading_crlf} $message] >= 0
                && [regexp {pre-HTTP/1\.0|invalid request: 400} $message]} {
                nsv_lappend legacyRequest diagnostics [list $severity $message]
            }
        }}}]
    } -body {
        if {$rejected} {
            set reply [::leadingCRLF::exchange [list "GET /__leading_crlf-\xff\r\n"]]
            set pattern {invalid request: 400 .* from peer (::1|127\.0\.0\.1): Invalid UTF-8 encoding in url .*\[pre-HTTP/1\.0\]}
            set finalSeverity Warning
        } else {
            set reply [lindex [nstest::http-0.9 -http "" -getbody 1 GET /__leading_crlf] end]
            set pattern {^pre-HTTP/1\.0 request <GET /__leading_crlf>$}
            set finalSeverity Notice
        }
        set deadline [expr {[clock milliseconds] + 2000}]
        while {$finalSeverity ni [lmap entry [nsv_get legacyRequest diagnostics] {lindex $entry 0}]
               && [clock milliseconds] < $deadline} {
            ns_sleep 10ms
        }
        set diagnostics [nsv_get legacyRequest diagnostics]
        lassign [lindex $diagnostics 0] severity message
        list $reply [llength $diagnostics] $severity [regexp $pattern $message]
    } -cleanup {
        ns_logctl unregister $filter
        nsv_unset -nocomplain legacyRequest
        ::leadingCRLF::cleanup
        ns_logctl severity Notice $noticeEnabled
        ns_logctl severity Warning $warningEnabled
    } -result $expected
}

foreach {suffix target description expected} {
    1 /__malformed_host {malformed Host logs once and falls back to the default server} {{200 test} 1 0}
    2 {/__malformed_host-\xff} {malformed Host logs once when URL validation rejects the request} {{400 {}} 1 1}
} {
    test driver-malformed-host-1.$suffix $description -constraints serverListen -setup {
        ns_register_proc GET /__malformed_host {ns_return 200 text/plain [ns_info server]}
        set warningEnabled [ns_logctl severity Warning]
        ns_logctl severity Warning on
        nsv_set malformedHost warnings {}
        set filter [ns_logctl register {apply {{severity timestamp message} {
            if {$severity eq "Warning"
                && ([string match {Cannot parse provided host header field *} $message]
                    || [string match {invalid request: 400 */__malformed_host*} $message])} {
                nsv_lappend malformedHost warnings $message
            }
        }}}]
    } -body {
        set targetBytes [subst -nocommands -novariables $target]
        set reply [::leadingCRLF::exchange [list "GET $targetBytes HTTP/1.1\r\nHost: \[broken\r\nConnection: close\r\n\r\n"]]
        set deadline [expr {[clock milliseconds] + 2000}]
        while {[llength [nsv_get malformedHost warnings]] < $suffix
               && [clock milliseconds] < $deadline} {
            ns_sleep 10ms
        }
        set warnings [nsv_get malformedHost warnings]
        list $reply \
            [llength [lsearch -all -exact $warnings {Cannot parse provided host header field <[broken>}]] \
            [llength [lsearch -all -glob $warnings {*Invalid UTF-8 encoding in url*}]]
    } -cleanup {
        ns_logctl unregister $filter
        ns_logctl severity Warning $warningEnabled
        nsv_unset -nocomplain malformedHost
        ns_unregister_op GET /__malformed_host
    } -result $expected
}

foreach {suffix requestLine headerLines status limitReason parseReason} {
    1 {GET /@ HTTP/1.1} {} 414 {request line is too long} {}
    2 {GET /__line_limit HTTP/1.1} {X-First: @\r\nX-Second: @\r\n} 431 {request header line is too long} {}
    3 {GET /@ HTTP/bad extra} {} 400 {request line is too long} {version information invalid}
    4 {GET /__line_limit HTTP/1.1} {@\r\n} 400 {request header line is too long} {Invalid Request Header}
} {
    test driver-line-limit-1.$suffix {overlong line produces one warning and preserves response} \
        -constraints serverListen -setup {
            set warningEnabled [ns_logctl severity Warning]
            ns_logctl severity Warning on
            nsv_set lineLimit warnings {}
            set filter [ns_logctl register {apply {{severity timestamp message} {
                if {$severity eq "Warning"
                    && [regexp {line is too long|invalid request: 400} $message]} {
                    nsv_lappend lineLimit warnings $message
                }
            }}}]
        } -body {
            set large [string repeat A [ns_config ns/module/nssock maxline]]
            set line [string map [list @ $large] $requestLine]
            set headers [string map [list @ $large] [subst -nocommands -novariables $headerLines]]
            set reply [::leadingCRLF::exchange [list "$line\r\nHost: localhost\r\nConnection: close\r\n$headers\r\n"]]
            set deadline [expr {[clock milliseconds] + 2000}]
            while {[clock milliseconds] < $deadline} {
                set warnings [nsv_get lineLimit warnings]
                if {$status == 400 ? [regexp {invalid request: 400} $warnings] : [llength $warnings] > 0} {
                    break
                }
                ns_sleep 10ms
            }
            set warnings [nsv_get lineLimit warnings]
            set message [lindex $warnings 0]
            list [lindex $reply 0] [llength $warnings] \
                [regexp {from peer (::1|127\.0\.0\.1)} $message] \
                [expr {[string first $limitReason $message] >= 0}] \
                [expr {$parseReason eq "" || [string first $parseReason $message] >= 0}]
        } -cleanup {
            ns_logctl unregister $filter
            ns_logctl severity Warning $warningEnabled
            nsv_unset -nocomplain lineLimit
        } -result [list $status 1 1 1 1]
}

foreach {status description} {
    414 {too many headers retains its driver response}
} {
    test driver-rejection-response-1.$status $description -constraints serverListen -setup {
        set warningEnabled [ns_logctl severity Warning]
        ns_logctl severity Warning on
        nsv_set rejectionResponse warnings {}
        set filter [ns_logctl register {apply {{severity timestamp message} {
            if {$severity eq "Warning"
                && [regexp {invalid request: (413|414)|request returns (413|414)|partial write while sending response|could not encode response headers|cannot add (access-log|log) entry} $message]} {
                nsv_lappend rejectionResponse warnings $message
            }
        }}}]
    } -body {
        set headers [string repeat "X-Test: value\r\n" [ns_config ns/module/nssock maxheaders]]
        set reply [::leadingCRLF::exchange [list "POST /__rejection_response HTTP/1.1\r\nHost: localhost\r\n$headers\r\n"]]
        list $reply [nsv_get rejectionResponse warnings]
    } -cleanup {
        ns_logctl unregister $filter
        ns_logctl severity Warning $warningEnabled
        nsv_unset -nocomplain rejectionResponse
    } -result [list [list $status {}] {}]
}

foreach {mode description} {
    expect {oversized Expect request emits one driver rejection warning}
    body {oversized request without Expect emits one warning}
    both {oversized Expect request with overlong header emits one combined warning}
} {
    test driver-body-limit-1.$mode $description -constraints serverListen -setup {
        set warningEnabled [ns_logctl severity Warning]
        ns_logctl severity Warning on
        nsv_set bodyLimit warnings {}
        set filter [ns_logctl register {apply {{severity timestamp message} {
            if {$severity eq "Warning"
                && [regexp {request too large|line is too long|invalid request: 413|request returns 413} $message]} {
                nsv_lappend bodyLimit warnings $message
            }
        }}}]
    } -body {
        set maxinput [ns_config ns/module/nssock maxinput]
        set length [expr {$maxinput + 1}]
        if {$mode eq "body"} {
            set reply [nstest::http -http 1.1 -partialresults 1 PUT /__body_limit [string repeat x $length]]
        } else {
            set headers ""
            if {$mode eq "both"} {
                set headers "X-Long: [string repeat x [ns_config ns/module/nssock maxline]]\r\n"
            }
            set reply [::leadingCRLF::exchange [list "PUT /__body_limit HTTP/1.1\r\nHost: localhost\r\n${headers}Content-Length: $length\r\nExpect: 100-continue\r\n\r\n"]]
        }
        set deadline [expr {[clock milliseconds] + 2000}]
        while {[llength [nsv_get bodyLimit warnings]] == 0 && [clock milliseconds] < $deadline} {
            ns_sleep 10ms
        }
        set warnings [nsv_get bodyLimit warnings]
        set message [lindex $warnings 0]
        list [lindex $reply 0] [llength $warnings] \
            [expr {[string first "request too large, length=$length, maxinput=$maxinput" $message] >= 0}] \
            [regexp {from peer (::1|127\.0\.0\.1)} $message] \
            [expr {$mode ne "both" || [string first {request header line is too long} $message] >= 0}]
    } -cleanup {
        ns_logctl unregister $filter
        ns_logctl severity Warning $warningEnabled
        nsv_unset -nocomplain bodyLimit
    } -result {413 1 1 1 1}
}

# A minimal ClientHello, with a newline in the random to exercise the old
# HTTP-line parser failure before a fragmented SNI extension has arrived.
proc ::leadingCRLF::hello {name} {
    set extensions ""
    if {$name ne ""} {
        set entry "\x00[binary format S [string length $name]]$name"
        set sni "[binary format S [string length $entry]]$entry"
        set extensions "\x00\x00[binary format S [string length $sni]]$sni"
    }
    set body "\x03\x03[string repeat \x0a 32]\x00\x00\x02\x00\x2f\x01\x00[binary format S [string length $extensions]]$extensions"
    set handshake "\x01\x00[binary format S [string length $body]]$body"
    return "\x16\x03\x01[binary format S [string length $handshake]]$handshake"
}
foreach {suffix name splits expected} {
    1 fisheye.openacs.org {} 1
    2 fisheye.openacs.org {1 2 4 48 65} 1
    3 {} {2 4 30} 0
    4 {bad\nname} {} 0
    5 fisheye.openacs.org {} 0
    6 fisheye.openacs.org {} 0
    7 fisheye.openacs.org {} 0
    8 fisheye.openacs.org {} 0
} {
    test driver-tls-sni-1.$suffix {TLS rejection logs bounded SNI once across socket reads} \
        -constraints serverListen -setup {
            set warningEnabled [ns_logctl severity Warning]
            ns_logctl severity Warning on
            nsv_set tlsSni warnings {}
            set filter [ns_logctl register {apply {{severity timestamp message} {
                if {$severity eq "Warning" && [string match {*received TLS handshake on a non-TLS connection*} $message]} {
                    nsv_lappend tlsSni warnings $message
                }
            }}}]
        } -body {
            set hello [::leadingCRLF::hello [subst -nocommands -novariables $name]]
            switch $suffix {
                5 {set hello [string replace $hello 50 51 [binary format S 65535]]}
                6 {set hello [string replace $hello 6 8 "\xff\xff\xff"]}
                7 {set hello [string replace $hello 3 4 [binary format S 65535]]}
                8 {set hello [::leadingCRLF::hello [string repeat a 254]]}
            }
            set parts {}
            set start 0
            foreach end $splits {
                lappend parts [string range $hello $start [expr {$end-1}]]
                set start $end
            }
            lappend parts [string range $hello $start end]
            set response [::leadingCRLF::exchange $parts]
            set deadline [expr {[clock milliseconds] + 2000}]
            while {[llength [nsv_get tlsSni warnings]] == 0 && [clock milliseconds] < $deadline} {
                ns_sleep 10ms
            }
            set warnings [nsv_get tlsSni warnings]
            list $response [llength $warnings] \
                [string match {*; SNI hostname fisheye.openacs.org} [lindex $warnings 0]] \
                [string match {*from peer *} [lindex $warnings 0]]
        } -cleanup {
            ns_logctl unregister $filter
            ns_logctl severity Warning $warningEnabled
            nsv_unset -nocomplain tlsSni
        } -result [list {400 {}} 1 $expected 1]
}

# A complete HTTP/2 client preface must be diagnosed without interpreting PRI
# as an HTTP/1 method. Matching prefixes survive individual socket reads.
foreach {suffix cuts valid} {
    1 {} 1
    2 {1 8 15 16 18 21} 1
    3 {} 0
} {
    test driver-http2-preface-1.$suffix {HTTP/2 preface has one specific rejection diagnostic} \
        -constraints serverListen -setup {
            set warningEnabled [ns_logctl severity Warning on]
            nsv_set http2Preface warnings {}
            set filter [ns_logctl register {apply {{severity timestamp message} {
                if {$severity eq "Warning" && [regexp {HTTP/2|ASTERISK|cannot parse request line} $message]} {
                    nsv_lappend http2Preface warnings $message
                }
            }}}]
        } -body {
            set preface "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
            if {!$valid} {set preface [string replace $preface 18 19 XX]}
            # Empty SETTINGS frame, sent in the final write with the preface.
            append preface [binary format H* 000000040000000000]
            set parts {}
            set start 0
            foreach end $cuts {
                lappend parts [string range $preface $start [expr {$end-1}]]
                set start $end
            }
            lappend parts [string range $preface $start end]
            set reply [::leadingCRLF::exchange $parts]
            set deadline [expr {[clock milliseconds] + 2000}]
            while {[llength [nsv_get http2Preface warnings]] == 0 && [clock milliseconds] < $deadline} {
                ns_sleep 10ms
            }
            set warnings [nsv_get http2Preface warnings]
            set message [lindex $warnings 0]
            list $reply [llength $warnings] \
                [expr {[string first {received HTTP/2 connection preface on an HTTP/1 connection} $message] >= 0}] \
                [expr {[string first {invalid ASTERISK request} $message] >= 0}] \
                [regexp {invalid request: 400 .* from peer (::1|127[.]0[.]0[.]1):} $message]
        } -cleanup {
            ns_logctl unregister $filter
            ns_logctl severity Warning $warningEnabled
            nsv_unset -nocomplain http2Preface
        } -returnCodes {error ok} -result [list {400 {}} 1 $valid [expr {!$valid}] 1]
}

test driver-http2-preface-2 {ordinary POST request remains HTTP/1} \
    -constraints serverListen -setup {::leadingCRLF::setup} -body {
        ::leadingCRLF::exchange [list "POST /__leading_crlf HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\nConnection: close\r\n\r\ntest"]
    } -cleanup {::leadingCRLF::cleanup} -returnCodes {error ok} -result {200 test}

namespace delete ::leadingCRLF
cleanupTests
