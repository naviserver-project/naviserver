#
# Public-API regressions use ns_connchan; only Tcl and NaviServer are required.
# Deterministic timing/failure injection is an optional developer check in
# developer/test-sock-happy-eyeballs.sh, outside the regular test suite.

package require tcltest 2.2
namespace import -force ::tcltest::*
::tcltest::configure {*}$argv

namespace eval ::happy_eyeballs_test {
    variable handles {}
    proc cleanup {} {
        variable handles
        foreach handle $handles {catch {ns_connchan close $handle}}
        set handles {}
    }
    proc listen {address} {
        variable handles
        set callback [list apply {{channel} {
            catch {ns_connchan write $channel ping}
            ns_connchan close $channel
            return 1
        }}]
        set info [ns_connchan listen -bind $address 0 $callback]
        set listener [dict get $info channel]
        lappend handles $listener
        return [list $listener [dict get $info port]]
    }
    proc exchange {address host {timeout 2s}} {
        variable handles
        lassign [listen $address] listener port
        set client [ns_connchan connect -timeout $timeout -- $host $port]
        lappend handles $client
        receive $client
    }

    proc receive {handle} {
        set deadline [expr {[clock milliseconds] + 2000}]
        set data {}
        while {[string length $data] < 4 && [clock milliseconds] < $deadline} {
            append data [ns_connchan read $handle]
            if {[string length $data] < 4} {after 5}
        }
        return $data
    }

}

set haveIPv6 false
if {[ns_info ipv6] && ![catch {
    ::happy_eyeballs_test::listen ::1
    ns_addrbyhost ::1
}]} {
    set haveIPv6 true
}
::happy_eyeballs_test::cleanup
testConstraint happyEyeballsIPv6 $haveIPv6

test happy-eyeballs-ipv4 {timed IPv4 connect returns usable connection channels} -body {
    ::happy_eyeballs_test::exchange 127.0.0.1 127.0.0.1
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result ping

test happy-eyeballs-ipv6 {timed IPv6 connect returns usable connection channels} \
    -constraints happyEyeballsIPv6 -body {
    ::happy_eyeballs_test::exchange ::1 ::1
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result ping

test happy-eyeballs-localhost {resolver addresses can reach an IPv4-only listener} -body {
    # Includes cross-family fallback if localhost resolves to IPv6 first.
    # Do not depend on system resolver order or external DNS/network routing.
    ::happy_eyeballs_test::exchange 127.0.0.1 localhost
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result ping

test happy-eyeballs-zero {zero budget reports NS_TIMEOUT and creates no channels} -body {
    lassign [::happy_eyeballs_test::listen 127.0.0.1] listener port
    set before [lsort [ns_connchan list]]
    set code [catch {ns_connchan connect -timeout 0 -- 127.0.0.1 $port} message options]
    if {!$code} {lappend ::happy_eyeballs_test::handles $message}
    list $code [dict get $options -errorcode] [expr {$before eq [lsort [ns_connchan list]]}]
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result {1 NS_TIMEOUT 1}

test happy-eyeballs-repeated-zero {repeated timeouts leave connection-channel ownership unchanged} -body {
    lassign [::happy_eyeballs_test::listen 127.0.0.1] listener port
    set before [lsort [ns_connchan list]]
    set timedOut 0
    for {set i 0} {$i < 32} {incr i} {
        set code [catch {ns_connchan connect -timeout 0 -- 127.0.0.1 $port} message options]
        if {!$code} {
            lappend ::happy_eyeballs_test::handles $message
        } elseif {[dict get $options -errorcode] eq "NS_TIMEOUT"} {
            incr timedOut
        }
    }
    list $timedOut [expr {$before eq [lsort [ns_connchan list]]}]
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result {32 1}

test happy-eyeballs-refused {refused connection is an error rather than a successful socket} -body {
    lassign [::happy_eyeballs_test::listen 127.0.0.1] listener port
    ns_connchan close $listener
    set before [lsort [ns_connchan list]]
    set code [catch {ns_connchan connect -timeout 2s -- 127.0.0.1 $port} message options]
    if {!$code} {lappend ::happy_eyeballs_test::handles $message}
    list $code [expr {[dict get $options -errorcode] ne "NS_TIMEOUT"}] \
        [expr {$before eq [lsort [ns_connchan list]]}]
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result {1 1 1}

test happy-eyeballs-large-budget {large connect budget allows immediate connchan success} -body {
    lassign [::happy_eyeballs_test::listen 127.0.0.1] listener port
    set handle [ns_connchan connect -timeout 2147484s -- 127.0.0.1 $port]
    lappend ::happy_eyeballs_test::handles $handle
    ns_connchan exists $handle
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result 1

test happy-eyeballs-connchan-zero {connchan propagates the shared zero-budget timeout} -body {
    lassign [::happy_eyeballs_test::listen 127.0.0.1] listener port
    set code [catch {ns_connchan connect -timeout 0 -- 127.0.0.1 $port} message options]
    if {!$code} {lappend ::happy_eyeballs_test::handles $message}
    list $code [dict get $options -errorcode]
} -cleanup {
    ::happy_eyeballs_test::cleanup
} -result {1 NS_TIMEOUT}

namespace delete ::happy_eyeballs_test
cleanupTests
