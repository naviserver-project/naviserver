# -*- Tcl -*-

package require tcltest 2.2
namespace import -force ::tcltest::*

::tcltest::configure {*}$argv

testConstraint with_deprecated [dict get [ns_info buildinfo] with_deprecated]

#######################################################################################
#  Syntax tests
#######################################################################################

test ns_schedule-1.1 {syntax: ns_schedule_proc} -body {
    ns_schedule_proc
} -returnCodes error -result {wrong # args: should be "ns_schedule_proc ?-once? ?-thread? ?--? /interval/ /script/ ?/arg .../?"}

test ns_schedule-1.2 {syntax: ns_unschedule_proc} -body {
    ns_unschedule_proc
} -returnCodes error -result {wrong # args: should be "ns_unschedule_proc /id/"}

test ns_schedule-1.3 {syntax: ns_schedule_daily} -body {
    ns_schedule_daily
} -returnCodes error -result {wrong # args: should be "ns_schedule_daily ?-once? ?-thread? ?--? /hour[0,23]/ /minute[0,59]/ /script/ ?/arg .../?"}

test ns_schedule-1.4 {syntax: ns_schedule_weekly} -body {
    ns_schedule_weekly
} -returnCodes error -result {wrong # args: should be "ns_schedule_weekly ?-once? ?-thread? ?--? /day[0,6]/ /hour[0,23]/ /minute[0,59]/ /script/ ?/arg .../?"}

test ns_schedule-1.5 {syntax: ns_after} -body {
    ns_after
} -returnCodes error -result {wrong # args: should be "ns_after /interval/ /script/ ?/arg .../?"}

test ns_schedule-1.6 {syntax: ns_pause} -body {
    ns_pause
} -returnCodes error -result {wrong # args: should be "ns_pause /id/"}

test ns_schedule-1.7 {syntax: ns_cancel} -constraints with_deprecated -body {
    ns_cancel
} -returnCodes error -result {wrong # args: should be "ns_cancel /id/"}

test ns_schedule-1.8 {syntax: ns_resume} -body {
    ns_resume
} -returnCodes error -result {wrong # args: should be "ns_resume /id/"}


#######################################################################################
#  Functional tests
#######################################################################################

test ns_schedule-2.0.1 {schedule proc: interval} -body {
    ns_schedule_proc 0s {ns_log notice ok}
} -returnCodes {error ok} -result {expected time value in range [0.000001s, MAX], for 'interval', but got 0}

test ns_schedule-2.0.2 {schedule proc: interval} -body {
    ns_schedule_proc -once 0 {nsv_set . . ns_schedule-2.0.2}
    ns_sleep 1s
    nsv_get . .
} -cleanup {
    nsv_unset . .
} -returnCodes {error ok} -result {ns_schedule-2.0.2}

test ns_schedule-2.1 {schedule proc: interval} -body {
    set id [ns_schedule_proc 1s {nsv_lappend . . ns_schedule-2.1}]
    ns_sleep 2.5s
    ns_unschedule_proc $id
    nsv_get . .
} -cleanup {
    nsv_unset . .
} -match glob -result {ns_schedule-2.1 ns_schedule-2.1*}

test ns_schedule-2.2 {schedule proc once} -body {
    set id [ns_schedule_proc -once -- 1s {nsv_lappend . . ns_schedule-2.2}]
    ns_sleep 2.5s
    ns_unschedule_proc $id
    nsv_get . .
} -cleanup {
    nsv_unset . .
} -result ns_schedule-2.2

test ns_schedule-2.3 {non thread procs run serially (racy)} -body {
    ns_schedule_proc -once -- 1 {
        ns_sleep 2s
        nsv_set . 1 [clock seconds]
    }
    ns_schedule_proc -once -- 1 {
        ns_sleep 2s
        nsv_set . 2 [clock seconds]
    }
    ns_sleep 6s
    expr {[nsv_get . 1] - [nsv_get . 2]}
} -cleanup {
    nsv_unset -nocomplain . 1
    nsv_unset -nocomplain . 2
} -result 2

test ns_schedule-2.4 {thread procs run concurrently} -body {
    ns_schedule_proc -once -thread -- 1 {
        ns_sleep 2.2s
        nsv_set . 1 [clock seconds]
    }
    ns_schedule_proc -once -- 1 {
        ns_sleep 2.2s
        nsv_set . 2 [clock seconds]
    }
    ns_sleep 6s
    set delta [expr {[nsv_get . 1] - [nsv_get . 2]}]
    expr $delta < 2
} -cleanup {
    nsv_unset -nocomplain . 1
    nsv_unset -nocomplain . 2
    unset -nocomplain delta
} -result 1




test ns_schedule-3.1 {scheduler diagnostic counters have a stable numeric schema} -body {
    set stats [ns_info scheduler]
    set valid 1
    foreach name {waitReturnLateness mutexAcquisition nonThreadedCallbacks dispatchLateness dispatchDelay workerQueueDelay threadedCallbacks callbackOverrun} {
        set timing [dict get $stats $name]
        foreach key {count over100ms lastSeconds totalSeconds maxSeconds} {
            if {![string is double -strict [dict get $timing $key]] || [dict get $timing $key] < 0} {set valid 0}
        }
        foreach key {lastId maxId} {
            if {![string is integer -strict [dict get $timing $key]]} {set valid 0}
        }
    }
    list $valid [string is integer -strict [dict get $stats lateLogsSuppressed]] [string is integer -strict [dict get $stats callbackLogsSuppressed]]
} -result {1 1 1}

test ns_schedule-3.2 {slow non-threaded callback and overdue dispatches are counted without per-event warnings} -setup {
    nsv_set schedDiagnostics done 0
    set before [ns_info scheduler]
    set ids {}
} -body {
    lappend ids [ns_schedule_proc -once 10ms {ns_sleep 350ms}]
    for {set i 0} {$i < 5} {incr i} {
        lappend ids [ns_schedule_proc -once 30ms {nsv_incr schedDiagnostics done}]
    }
    set deadline [expr {[clock milliseconds]+5000}]
    while {[nsv_get schedDiagnostics done] < 5 && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    set after [ns_info scheduler]
    list [expr {[nsv_get schedDiagnostics done] == 5}] \
        [expr {[dict get $after nonThreadedCallbacks over100ms] > [dict get $before nonThreadedCallbacks over100ms]}] \
        [expr {[dict get $after nonThreadedCallbacks maxSeconds] >= 0.3}] \
        [expr {[dict get $after dispatchLateness over100ms] >= [dict get $before dispatchLateness over100ms]+5}] \
        [expr {[dict get $after lateLogsSuppressed] >= [dict get $before lateLogsSuppressed]+4}]
} -cleanup {
    foreach id $ids {ns_unschedule_proc $id}
    nsv_unset -nocomplain schedDiagnostics
} -result {1 1 1 1 1}

test ns_schedule-3.3 {threaded execution is excluded from non-threaded callback duration} -setup {
    nsv_set schedDiagnostics done 0
    set before [ns_info scheduler]
} -body {
    set id [ns_schedule_proc -once -thread 10ms {ns_sleep 200ms; nsv_set schedDiagnostics done 1}]
    set deadline [expr {[clock milliseconds]+5000}]
    while {![nsv_get schedDiagnostics done] && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    set after [ns_info scheduler]
    list [nsv_get schedDiagnostics done] \
        [expr {[dict get $after nonThreadedCallbacks count] == [dict get $before nonThreadedCallbacks count]}] \
        [expr {[dict get $after waitReturnLateness count] > [dict get $before waitReturnLateness count]}]
} -cleanup {
    ns_unschedule_proc $id
    nsv_unset -nocomplain schedDiagnostics
} -result {1 1 1}


test ns_schedule-4.1 {database pool maintenance uses scheduler workers} -body {
    set pools {}
    set threaded 1
    foreach entry [ns_info scheduled] {
        if {[lindex $entry 7] eq "nsdb:checkpool"} {
            lappend pools [lindex $entry 8]
            if {!([lindex $entry 1] & 1)} {set threaded 0}
        }
    }
    list [expr {"a" in $pools && "b" in $pools}] $threaded
} -result {1 1}

test ns_schedule-4.2 {HTTP connection janitor uses a scheduler worker and continues repeating} -body {
    set id -1
    set previous -1
    set threaded 0
    foreach entry [ns_info scheduled] {
        if {[lindex $entry 7] eq "httpclient:close-waiting"} {
            set id [lindex $entry 0]
            set previous [lindex $entry 6]
            set threaded [expr {([lindex $entry 1] & 1) != 0}]
        }
    }
    set completed 0
    set deadline [expr {[clock milliseconds]+4000}]
    while {$id >= 0 && !$completed && [clock milliseconds] < $deadline} {
        ns_sleep 20ms
        foreach entry [ns_info scheduled] {
            if {[lindex $entry 0] == $id && [lindex $entry 6] > $previous} {set completed 1}
        }
    }
    list $threaded $completed
} -result {1 1}


test ns_schedule-4.3 {cancelling a paused event frees it and reports success} -setup {
    set id [ns_schedule_proc -once 60s {error "cancelled paused event ran"}]
} -body {
    set paused [ns_pause $id]
    set cancelled [ns_unschedule_proc $id]
    set present 0
    foreach entry [ns_info scheduled] {
        if {[lindex $entry 0] == $id} {set present 1}
    }
    list $paused $cancelled $present
} -cleanup {ns_unschedule_proc $id} -result {1 1 0}


test ns_schedule-5.1 {worker backlog is visible and queue delay is separate from callback runtime} -setup {
    nsv_set schedPhases starts 0
    nsv_set schedPhases done 0
    nsv_set schedPhases release 0
    set before [ns_info scheduler]
    set jobs [expr {[dict get $before workers current] + 4}]
    set ids {}
} -body {
    for {set i 0} {$i < $jobs} {incr i} {
        lappend ids [ns_schedule_proc -thread -once 10ms {
            nsv_incr schedPhases starts
            while {![nsv_get schedPhases release]} {ns_sleep 10ms}
            ns_sleep 120ms
            nsv_incr schedPhases done
        }]
    }
    set deadline [expr {[clock milliseconds] + 5000}]
    while {![nsv_get schedPhases starts] && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    set during [ns_info scheduler]
    ns_sleep 200ms
    nsv_set schedPhases release 1
    set deadline [expr {[clock milliseconds] + 5000}]
    while {[dict get [ns_info scheduler] threadedCallbacks count] < [dict get $before threadedCallbacks count] + $jobs
           && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    set after [ns_info scheduler]
    list [expr {[dict get $during queues waitingWorkers] > 0}] \
        [expr {[dict get $during workers running] > 0}] \
        [expr {[dict get $during workers current] == [dict get $during workers idle] + [dict get $during workers running]}] \
        [expr {[dict get $after workerQueueDelay over100ms] > [dict get $before workerQueueDelay over100ms]}] \
        [expr {[dict get $after threadedCallbacks over100ms] >= [dict get $before threadedCallbacks over100ms] + $jobs}] \
        [expr {[nsv_get schedPhases done] == $jobs}] \
        [expr {[dict get $after queues peakWaitingWorkers] >= [dict get $during queues waitingWorkers]}]
} -cleanup {
    nsv_set schedPhases release 1
    foreach id $ids {ns_unschedule_proc $id}
    nsv_unset -nocomplain schedPhases
} -result {1 1 1 1 1 1 1}

test ns_schedule-5.2 {threaded overrun is measured against next nominal time and laststart reflects worker pickup} -setup {
    nsv_set schedOverrun done 0
    set before [ns_info scheduler]
} -body {
    set id [ns_schedule_proc -thread 50ms {
        ns_sleep 200ms
        nsv_incr schedOverrun done
    }]
    set deadline [expr {[clock milliseconds] + 5000}]
    while {[dict get [ns_info scheduler] callbackOverrun over100ms] <= [dict get $before callbackOverrun over100ms]
           && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    ns_pause $id
    set after [ns_info scheduler]
    set startValid 0
    foreach entry [ns_info scheduled] {
        if {[lindex $entry 0] == $id} {
            set startValid [expr {[lindex $entry 5] >= [lindex $entry 4]}]
        }
    }
    list [expr {[dict get $after callbackOverrun over100ms] > [dict get $before callbackOverrun over100ms]}] \
        [expr {[dict get $after threadedCallbacks count] > [dict get $before threadedCallbacks count]}] \
        $startValid
} -cleanup {
    ns_unschedule_proc $id
    set deadline [expr {[clock milliseconds] + 2000}]
    while {[dict get [ns_info scheduler] workers running] && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    nsv_unset -nocomplain schedOverrun
} -result {1 1 1}


test ns_schedule-6.1 {completed one-shot callback maxima retain descriptions and observation times} -body {
    set results {}
    foreach {threaded timing marker} {false nonThreadedCallbacks completedNonThreadMarker true threadedCallbacks completedThreadMarker} {
        set before [dict get [ns_info scheduler] $timing]
        set duration [expr {max(0.5,[dict get $before maxSeconds]+0.15)}]
        set since [expr {[clock microseconds]/1000000.0}]
        set options [expr {$threaded ? {-thread} : {}}]
        set id [ns_schedule_proc -once {*}$options 10ms "ns_sleep [format %.6fs $duration]; set $marker 1"]
        set deadline [expr {[clock milliseconds]+int(ceil($duration*1000))+5000}]
        while {[dict get [ns_info scheduler] $timing maxId] != $id && [clock milliseconds] < $deadline} {ns_sleep 10ms}
        set maximum [dict get [ns_info scheduler] $timing]
        set liveIds [lmap entry [ns_info scheduled] {lindex $entry 0}]
        set observed [dict get $maximum maxObservedAt]
        lappend results [list [expr {$id ni $liveIds}] \
            [string match "*ns:tclschedproc*$marker*" [dict get $maximum maxCallback]] \
            [dict get $maximum maxCallbackTruncated] \
            [expr {$observed >= $since && $observed <= [clock microseconds]/1000000.0}] \
            [expr {[dict get $maximum maxSeconds] >= $duration}]]
    }
    set results
} -result {{1 1 0 1 1} {1 1 0 1 1}}

test ns_schedule-6.2 {bounded UTF-8 descriptions survive deletion and smaller callbacks do not overwrite maximum context} -body {
    set before [dict get [ns_info scheduler] threadedCallbacks]
    set duration [expr {[dict get $before maxSeconds]+0.15}]
    set script "# retainedUnicodeMarker [string repeat \u00e4 900]\nns_sleep [format %.6fs $duration]"
    set id [ns_schedule_proc -once -thread 10ms $script]
    set deadline [expr {[clock milliseconds]+int(ceil($duration*1000))+5000}]
    while {[dict get [ns_info scheduler] threadedCallbacks maxId] != $id && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    set maximum [dict get [ns_info scheduler] threadedCallbacks]
    set description [dict get $maximum maxCallback]
    set completed [dict get [ns_info scheduler] threadedCallbacks count]
    set shortId [ns_schedule_proc -once -thread 10ms {set shorterOneShotMarker 1}]
    set deadline [expr {[clock milliseconds]+5000}]
    while {[dict get [ns_info scheduler] threadedCallbacks count] <= $completed && [clock milliseconds] < $deadline} {ns_sleep 10ms}
    set later [dict get [ns_info scheduler] threadedCallbacks]
    set liveIds [lmap entry [ns_info scheduled] {lindex $entry 0}]
    list [expr {$id ni $liveIds}] [dict get $maximum maxCallbackTruncated] \
        [expr {[string length [encoding convertto utf-8 $description]] <= 1024}] \
        [expr {[string first retainedUnicodeMarker $description] >= 0}] \
        [expr {[string first \ufffd $description] < 0}] \
        [expr {[dict get $later maxCallback] eq $description}] \
        [expr {[dict get $later maxObservedAt] == [dict get $maximum maxObservedAt]}]
} -result {1 1 1 1 1 1 1}


cleanupTests

