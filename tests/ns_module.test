# -*- Tcl -*-
package require tcltest 2.2
namespace import -force ::tcltest::*
::tcltest::configure {*}$argv

# Native metadata callbacks require Tcl_FindSymbol, available since Tcl 8.6.
# Tcl module metadata registration is also supported on Tcl 8.5.
testConstraint nativeModuleMetadata [expr {[package vcompare [info patchlevel] 8.6] >= 0}]

test ns_module-require-1.0 {syntax: ns_module require} -setup {
    set savedModuleStack $::ns_module::stack
    set ::ns_module::stack {{syntax-test syntax.tcl}}
} -body {
    ns_module require
} -cleanup {
    set ::ns_module::stack $savedModuleStack
} -returnCodes error -result {wrong # args: should be "ns_module require ?-module /module/? ?/file .../?"}

test ns_module-require-1.1 {syntax: ns_module require -module} -setup {
    set savedModuleStack $::ns_module::stack
    set ::ns_module::stack {{syntax-test syntax.tcl}}
} -body {
    ns_module require -module
} -cleanup {
    set ::ns_module::stack $savedModuleStack
} -returnCodes error -result {wrong # args: should be "ns_module require ?-module /module/? ?/file .../?"}

test ns_module-require-1.2 {syntax: ns_module require -core} -setup {
    set savedModuleStack $::ns_module::stack
    set ::ns_module::stack {{syntax-test syntax.tcl}}
} -body {
    ns_module require -core
} -cleanup {
    set ::ns_module::stack $savedModuleStack
} -returnCodes error -result {wrong # args: should be "ns_module require -core /file/ ?/file .../?"}

test ns_module-files-1.0 {syntax: ns_module files} -body {
    ns_module files
} -returnCodes error -result {wrong # args: should be "ns_module files /module|-core/"}

test ns_module-reload-1.0 {syntax: ns_module reload} -body {
    ns_module reload
} -returnCodes error -result {wrong # args: should be "ns_module reload ?-core? /module|file/ ?/file .../?"}

test ns_module-reload-1.1 {syntax: ns_module reload -core} -body {
    ns_module reload -core
} -returnCodes error -result {wrong # args: should be "ns_module reload ?-core? /module|file/ ?/file .../?"}

test ns_module-name-1.0 {syntax: ns_module name} -body {
    ns_module name x y
} -returnCodes error -result {wrong # args: should be "ns_module name ?/value/?"}

test ns_module-shared-1.0 {syntax: ns_module shared} -body {
    ns_module shared x y
} -returnCodes error -result {wrong # args: should be "ns_module shared ?/value/?"}

test ns_module-private-1.0 {syntax: ns_module private} -body {
    ns_module private x y
} -returnCodes error -result {wrong # args: should be "ns_module private ?/value/?"}

test ns_module-version-1.0 {syntax: ns_module version} -body {
    ns_module version x y
} -returnCodes error -result {wrong # args: should be "ns_module version ?/value/?"}

test ns_module-tag-1.0 {syntax: ns_module tag} -body {
    ns_module tag x y
} -returnCodes error -result {wrong # args: should be "ns_module tag ?/value/?"}

test ns_module-clear-1.0 {syntax: ns_module clear} -body {
    ns_module clear x
} -returnCodes error -result {wrong # args: should be "ns_module clear"}

test ns_module-metadata-1 {Tcl module metadata survives startup} -body {
    set info [dict get [ns_server modules] module-metadata]
    list [dict get $info type] [dict get $info version] [dict get $info tag] [dict get $info scope]
} -returnCodes {ok error} -result {tcl-module 1.2.3 test-test server}

test ns_module-metadata-2 {module metadata is scoped to its virtual server} -body {
    dict get [ns_server -server testvhost modules] module-metadata tag
} -returnCodes {ok error} -result test-testvhost

test ns_module-metadata-3 {identical redefinitions fail during startup} -body {
    nsv_get module-metadata redefinition
} -returnCodes {ok error} -result {1 {module 'module-metadata' version is already defined} 1 {module 'module-metadata' tag is already defined}}

test ns_module-metadata-4 {empty values are rejected} -body {
    nsv_get module-metadata empty
} -returnCodes {ok error} -result 1

test ns_module-metadata-5 {native callback fields cannot be redefined} -constraints nativeModuleMetadata -body {
    nsv_get module-metadata native
} -returnCodes {ok error} -result {1 {module 'nslog' version is already defined} 1 {module 'nslog' tag is already defined}}

test ns_module-metadata-6 {metadata cannot be registered after startup} -body {
    ns_ictl moduleinfo module-metadata tag late
} -returnCodes {ok error} -result {cannot set module metadata after server startup}

test ns_module-metadata-7 {module context is required} -body {
    ns_module version 2.0
} -returnCodes {ok error} -result {ns_module: no module is being initialized}

test ns_module-metadata-8 {version data can be sourced again without redefining metadata} -body {
    set before [dict get [ns_server modules] module-metadata]
    source [file join [ns_library private module-metadata] version.tcl]
    list $::module_metadata::version [expr {$before eq [dict get [ns_server modules] module-metadata]}]
} -returnCodes {ok error} -result {1.2.3 1}

cleanupTests
