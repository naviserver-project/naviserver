#
# Exercise the public API using the system's localhost name service. Mixed
# case spellings provide distinct existing cache keys without external DNS.
# Exact DNS arrival schedules are covered by the optional developer check.

package require tcltest 2.2
namespace import -force ::tcltest::*
::tcltest::configure {*}$argv

namespace eval ::dns_happy_eyeballs_test {
    variable channels {}
    variable handles {}
    variable threads {}
    proc listen {} {
        variable channels
        set listener [ns_socklisten 127.0.0.1 0]
        lappend channels $listener
        return [list $listener [lindex [fconfigure $listener -sockname] end]]
    }
    proc cleanup {} {
        variable channels
        variable handles
        variable threads
        foreach thread $threads {catch {ns_thread wait $thread}}
        foreach channel $channels {catch {close $channel}}
        foreach handle $handles {catch {ns_connchan close $handle}}
        set channels {}
        set handles {}
        set threads {}
    }
}

test dns-happy-eyeballs-cold {independent family resolution reaches an IPv4-only listener} -body {
    lassign [::dns_happy_eyeballs_test::listen] listener port
    set pair [ns_sockopen -timeout 2s -- lOcAlHoSt $port]
    lappend ::dns_happy_eyeballs_test::channels {*}$pair
    set accepted [ns_sockaccept $listener]
    lappend ::dns_happy_eyeballs_test::channels {*}$accepted
    foreach channel [concat $pair $accepted] {
        fconfigure $channel -translation binary -buffering none
    }
    puts -nonewline [lindex $pair 1] dns
    read [lindex $accepted 0] 3
} -cleanup {
    ::dns_happy_eyeballs_test::cleanup
} -result dns

test dns-happy-eyeballs-cache {combined resolver cache and first-address API remain consistent} -body {
    set expected [lsort -unique [ns_addrbyhost -all localhost]]
    set actual [ns_addrbyhost -all lOcAlHoSt]
    list [expr {$expected eq [lsort -unique $actual]}] \
        [expr {[ns_addrbyhost lOcAlHoSt] eq [lindex $actual 0]}]
} -result {1 1}

test dns-happy-eyeballs-warm {completed cached answers remain usable by timed connects} -body {
    ns_addrbyhost -all LoCaLhOsT
    lassign [::dns_happy_eyeballs_test::listen] listener port
    set pair [ns_sockopen -timeout 2s -- LoCaLhOsT $port]
    lappend ::dns_happy_eyeballs_test::channels {*}$pair
    llength $pair
} -cleanup {
    ::dns_happy_eyeballs_test::cleanup
} -result 2

test dns-happy-eyeballs-zero {zero TCP budget remains a TCP timeout after name resolution} -body {
    lassign [::dns_happy_eyeballs_test::listen] listener port
    set before [lsort [chan names]]
    set code [catch {ns_sockopen -timeout 0 -- locALHOst $port} message options]
    if {!$code} {lappend ::dns_happy_eyeballs_test::channels {*}$message}
    list $code [dict get $options -errorcode] \
        [expr {$before eq [lsort [chan names]]}]
} -cleanup {
    ::dns_happy_eyeballs_test::cleanup
} -result {1 NS_TIMEOUT 1}

test dns-happy-eyeballs-concurrent {concurrent subscribers can detach without losing other results} -body {
    lassign [::dns_happy_eyeballs_test::listen] listener port
    for {set i 0} {$i < 4} {incr i} {
        lappend ::dns_happy_eyeballs_test::threads [ns_thread create [list apply {
            {host port} {
                set pair [ns_sockopen -timeout 2s -- $host $port]
                foreach channel $pair {close $channel}
                return 1
            }
        } loCALhoST $port]]
    }
    set results {}
    foreach thread $::dns_happy_eyeballs_test::threads {
        lappend results [ns_thread wait $thread]
    }
    set ::dns_happy_eyeballs_test::threads {}
    set results
} -cleanup {
    ::dns_happy_eyeballs_test::cleanup
} -result {1 1 1 1}

test dns-happy-eyeballs-connchan {connchan uses the same independent resolver path} -body {
    lassign [::dns_happy_eyeballs_test::listen] listener port
    set handle [ns_connchan connect -timeout 2s -- LOCALhost $port]
    lappend ::dns_happy_eyeballs_test::handles $handle
    ns_connchan exists $handle
} -cleanup {
    ::dns_happy_eyeballs_test::cleanup
} -result 1

test dns-happy-eyeballs-cancel-subscribers {zero-budget subscribers detach safely in parallel} -body {
    lassign [::dns_happy_eyeballs_test::listen] listener port
    for {set i 0} {$i < 8} {incr i} {
        lappend ::dns_happy_eyeballs_test::threads [ns_thread create [list apply {
            {host port} {
                set failures 0
                for {set j 0} {$j < 4} {incr j} {
                    if {[catch {ns_sockopen -timeout 0 -- $host $port} message options]
                        && [dict get $options -errorcode] eq "NS_TIMEOUT"} {
                        incr failures
                    }
                }
                return $failures
            }
        } loCaLhOST $port]]
    }
    set failures 0
    foreach thread $::dns_happy_eyeballs_test::threads {
        incr failures [ns_thread wait $thread]
    }
    set ::dns_happy_eyeballs_test::threads {}
    set failures
} -cleanup {
    ::dns_happy_eyeballs_test::cleanup
} -result 32

test dns-happy-eyeballs-failed-name {failed resolution is not reported as a TCP timeout} -body {
    set before [lsort [chan names]]
    set code [catch {ns_sockopen -timeout 2s -- ::not-an-address 80} message options]
    if {!$code} {lappend ::dns_happy_eyeballs_test::channels {*}$message}
    list $code [expr {[dict get $options -errorcode] ne "NS_TIMEOUT"}] \
        [expr {$before eq [lsort [chan names]]}]
} -cleanup {
    ::dns_happy_eyeballs_test::cleanup
} -result {1 1 1}

namespace delete ::dns_happy_eyeballs_test
cleanupTests
