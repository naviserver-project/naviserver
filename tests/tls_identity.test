#
# Outbound TLS must authenticate the requested DNS name or numeric IP,
# independently of SNI and of previously cached connections.

package require tcltest 2.2
namespace import -force ::tcltest::*
::tcltest::configure {*}$argv

testConstraint ssl [ns_info ssl]
if {![testConstraint ssl]} {
    cleanupTests
    return
}
testConstraint tlsIdentityServer [expr {[ns_config test tls_listenport] ne ""}]

proc tlsIdentityRequest {api args} {
    set url [expr {[info exists ::tlsIdentityURL] ? $::tlsIdentityURL : "[ns_config test tls_listenurl]/123"}]
    switch -- $api {
        http {
            dict get [ns_http run -timeout 10s -keepalive 0s {*}$args $url] status
        }
        open {
            set channel [ns_connchan open -timeout 10s {*}$args $url]
            ns_connchan close $channel
            return 200
        }
        connect {
            set conf [ns_parseurl $url]
            set channel [ns_connchan connect -tls -timeout 10s {*}$args \
                             [dict get $conf host] [dict get $conf port]]
            ns_connchan close $channel
            return 200
        }
    }
}

foreach api {http open connect} {
    test tls-identity-$api-1 {matching DNS identity over numeric transport} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname localhost
    } -result 200

    test tls-identity-$api-2 {unrelated trusted DNS certificate is rejected} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname not-in-certificate.example
    } -returnCodes error -match glob -result {*mismatch*}

    test tls-identity-$api-3 {numeric URL/remote host matches IP SAN without SNI} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api
    } -result 200

    test tls-identity-$api-4 {unrelated IPv4 identity is rejected} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname 192.0.2.123
    } -returnCodes error -match glob -result {*mismatch*}

    test tls-identity-$api-5 {unrelated IPv6 identity is rejected} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname 2001:db8::123
    } -returnCodes error -match glob -result {*mismatch*}

    test tls-identity-$api-6 {explicit insecure mode permits a DNS mismatch} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -insecure -hostname not-in-certificate.example
    } -result 200

    test tls-identity-$api-7 {explicit insecure mode permits an IP mismatch} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -insecure -hostname 192.0.2.123
    } -result 200

    test tls-identity-$api-8 {empty explicit identity cannot disable verification} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname {}
    } -returnCodes error -match glob -result {*verification requires a peer hostname or IP address*}
    test tls-identity-$api-9 {matching IPv4 SAN over numeric transport} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname 127.0.0.1
    } -result 200
    test tls-identity-$api-10 {bracketed IPv6 reference identity} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname {[::1]}
    } -result 200
    test tls-identity-$api-11 {IPv6 zone is not part of certificate identity} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname ::1%1
    } -result 200

    test tls-identity-$api-12 {a DNS suffix is not a single peer identity} \
        -constraints {tlsIdentityServer} -body {
        tlsIdentityRequest $api -hostname .localhost
    } -returnCodes error -match glob -result {*invalid DNS peer identity*}

}

test tls-identity-reuse-1 {an insecure cached connection cannot bypass verification} \
    -constraints {tlsIdentityServer} -body {
    set url [ns_config test tls_listenurl]/123
    ns_http run -timeout 10s -keepalive 10s -insecure \
        -hostname not-in-certificate.example $url
    ns_http run -timeout 10s -keepalive 10s \
        -hostname not-in-certificate.example $url
} -returnCodes error -match glob -result {*mismatch*}

test tls-identity-reuse-2 {a cached connection cannot bypass a changed identity} \
    -constraints {tlsIdentityServer} -body {
    set url [ns_config test tls_listenurl]/123
    ns_http run -timeout 10s -keepalive 10s -hostname localhost $url
    ns_http run -timeout 10s -keepalive 10s -hostname not-in-certificate.example $url
} -returnCodes error -match glob -result {*mismatch*}

test tls-identity-reuse-3 {same-policy TLS connections remain reusable} \
    -constraints {tlsIdentityServer} -body {
    ns_register_proc GET /tls-identity-peer {
        ns_return 200 text/plain [ns_conn peerport]
    }
    set url [ns_config test tls_listenurl]/tls-identity-peer
    set peers {}
    for {set i 0} {$i < 3} {incr i} {
        lappend peers [dict get [ns_http run -timeout 10s -keepalive 10s \
                                   -hostname localhost $url] body]
    }
    ns_unregister_op GET /tls-identity-peer
    expr {[llength [lsort -unique $peers]] == 1}
} -result 1

# Keep the CONNECT relay self-contained so the test controls how the
# response is split and can run on older branches without revproxy.
proc tlsIdentityProxyStart {} {
    set loopback [ns_config test loopback]
    set table tls-identity-[clock clicks]
    nsv_set $table channels {}
    set relay {{source target event} {
        if {$event ne "r" || [set data [ns_connchan read $source]] eq ""} {
            catch {ns_connchan close $target}
            return 0
        }
        if {[ns_connchan write $target $data] != [string length $data]} {
            error "short write in CONNECT relay"
        }
        return 1
    }}
    set receive {{table loopback targetPort relay client event} {
        if {[nsv_exists $table backend]} {
            return [apply $relay $client [nsv_get $table backend] $event]
        }
        if {$event ne "r" || [set data [ns_connchan read $client]] eq ""} {
            return 0
        }
        set request [nsv_append $table request $data]
        if {[string first "\r\n\r\n" $request] < 0} {
            return 1
        }
        set line [string range $request 0 [expr {[string first "\r\n" $request] - 1}]]
        if {![regexp {^CONNECT (\[[^]]+\]|[^:]+):[0-9]+ HTTP/1\.1$} $line]} {
            error "unexpected CONNECT request: $line"
        }

        set backend [ns_connchan connect -timeout 2s -- $loopback $targetPort]
        nsv_lappend $table channels $backend
        nsv_set $table backend $backend
        ns_connchan callback -timeout 10s -sendtimeout 2s $backend \
            [list apply $relay $backend $client] rx

        # The status line alone does not complete the CONNECT response.
        ns_connchan write $client "HTTP/1.1 200 Connection established\r\n"
        after 100
        ns_connchan write $client "\r\n"
        return 1
    }}
    set accept [list apply {{table receive loopback targetPort relay client} {
        nsv_lappend $table channels $client
        ns_connchan callback -timeout 10s -sendtimeout 2s $client \
            [list apply $receive $table $loopback $targetPort $relay $client] rx
        return 1
    }} $table $receive $loopback [ns_config test tls_listenport] $relay]
    if {[catch {ns_connchan listen -bind $loopback 0 $accept} listener options]} {
        nsv_unset $table
        return -options $options $listener
    }
    return [list [dict get $listener channel] $table \
                [dict create host $loopback port [dict get $listener port]]]
}
proc tlsIdentityProxyStop {fixture} {
    if {$fixture eq ""} {return}
    lassign $fixture listener table
    ns_connchan close $listener
    foreach channel [nsv_get $table channels] {
        catch {ns_connchan close $channel}
    }
    nsv_unset $table
}

test tls-identity-proxy-1 {HTTPS CONNECT tunnel performs TLS and identity checking} \
    -constraints {tlsIdentityServer} -setup {
    set fixture {}
    set fixture [tlsIdentityProxyStart]
} -body {
    dict get [ns_http run -timeout 10s -hostname localhost -proxy [lindex $fixture 2] \
                  [ns_config test tls_listenurl]/123] status
} -cleanup {tlsIdentityProxyStop $fixture} -result 200

test tls-identity-proxy-2 {HTTPS CONNECT rejects a mismatching target identity} \
    -constraints {tlsIdentityServer} -setup {
    set fixture {}
    set fixture [tlsIdentityProxyStart]
} -body {
    ns_http run -timeout 10s -hostname not-in-certificate.example -proxy [lindex $fixture 2] \
        [ns_config test tls_listenurl]/123
} -cleanup {tlsIdentityProxyStop $fixture} -returnCodes error -match glob -result {*mismatch*}

# A trusted DNS-only certificate must NOT authenticate a numeric URL.
# This fixture exercises the default identity, without a -hostname override.
# Use the same executable as the Makefile's certificate recipes.
# Keep the default for runs started directly with nsd.
set ::tlsIdentityOpenSSL [auto_execok [expr {[info exists ::env(OPENSSL)]
                                           ? $::env(OPENSSL) : "openssl"}]]
testConstraint tlsIdentityOpenSSLCLI [expr {$::tcl_platform(platform) eq "unix"
                                           && $::tlsIdentityOpenSSL ne ""}]
proc tlsIdentityDNSOnlyStart {{host ""} {unixSocket ""}} {
    set dir [makeDirectory tls-identity-dns-only]
    set config [open [file join $dir openssl.cnf] w]
    puts $config {[req]
prompt = no
distinguished_name = subject
x509_extensions = extensions
[subject]
CN = localhost
[extensions]
basicConstraints = critical, CA:TRUE
subjectAltName = DNS:localhost}
    close $config
    exec {*}$::tlsIdentityOpenSSL req -new -x509 -nodes -newkey rsa:2048 -sha256 -days 1 \
        -config [file join $dir openssl.cnf] -keyout [file join $dir key.pem] \
        -out [file join $dir cert.pem] 2>[file join $dir req.log]
    if {$host eq ""} {set host [ns_config test loopback]}
    set probe [socket -server {apply {{args} {}}} -myaddr $host 0]
    set port [lindex [fconfigure $probe -sockname] end]
    close $probe
    set endpoint [expr {[string first : $host] >= 0 ? "\[$host\]:$port" : "$host:$port"}]
    set transport [expr {$unixSocket eq "" ? [list -accept $endpoint] : [list -unix $unixSocket]}]
    set child [exec {*}$::tlsIdentityOpenSSL s_server -quiet -www {*}$transport \
                   -cert [file join $dir cert.pem] -key [file join $dir key.pem] \
                   >[file join $dir server.log] 2>@1 &]
    for {set i 0} {$i < 500} {incr i} {
        if {$unixSocket ne "" && [file exists $unixSocket]} {
            set ::tlsIdentityURL https://$endpoint/123
            return [list $child $dir]
        }
        if {$unixSocket eq "" && ![catch {set probe [socket $host $port]}]} {
            close $probe
            set ::tlsIdentityURL https://$endpoint/123
            return [list $child $dir]
        }
        ns_sleep 10ms
    }
    catch {exec kill -TERM {*}$child}
    error "DNS-only TLS fixture did not start; see [file join $dir server.log]"
}
proc tlsIdentityDNSOnlyStop {fixture} {
    if {$fixture eq ""} {return}
    lassign $fixture child dir
    catch {exec kill -TERM {*}$child}
    unset -nocomplain ::tlsIdentityURL
    removeDirectory $dir
}
testConstraint tlsIdentityIPv6 [expr {![catch {
    set probe [socket -server {apply {{args} {}}} -myaddr ::1 0]
    close $probe
}]}]
foreach {family host extraConstraint} {ipv4 127.0.0.1 tlsIdentityServer ipv6 ::1 tlsIdentityIPv6} {
foreach api {http open connect} {
    test tls-identity-default-ip-$api-$family {DNS-only certificate cannot authenticate numeric destination} \
        -constraints [list tlsIdentityServer tlsIdentityOpenSSLCLI $extraConstraint] -setup {
        set fixture {}
        set fixture {}
    set fixture [tlsIdentityDNSOnlyStart $host]
    } -body {
        tlsIdentityRequest $api -cafile [file join [lindex $fixture 1] cert.pem]
    } -cleanup {tlsIdentityDNSOnlyStop $fixture} \
        -returnCodes error -match glob -result {*mismatch*}

    test tls-identity-dns-control-$api-$family {DNS-only certificate authenticates explicit matching DNS identity} \
        -constraints [list tlsIdentityServer tlsIdentityOpenSSLCLI $extraConstraint] -setup {
        set fixture {}
        set fixture {}
    set fixture [tlsIdentityDNSOnlyStart $host]
    } -body {
        tlsIdentityRequest $api -cafile [file join [lindex $fixture 1] cert.pem] -hostname localhost
    } -cleanup {tlsIdentityDNSOnlyStop $fixture} -result 200
}

}

test tls-identity-reuse-4 {changed CA configuration cannot reuse an earlier trust decision} \
    -constraints {tlsIdentityServer tlsIdentityOpenSSLCLI} -setup {
    set fixture {}
    set fixture [tlsIdentityDNSOnlyStart 127.0.0.1]
    unset ::tlsIdentityURL
    set emptyCApath [makeDirectory tls-identity-empty-ca]
} -body {
    set url [ns_config test tls_listenurl]/123
    ns_http run -timeout 10s -keepalive 10s -hostname localhost $url
    ns_http run -timeout 10s -keepalive 10s -hostname localhost \
        -cafile [file join [lindex $fixture 1] cert.pem] -capath $emptyCApath $url
} -cleanup {
    tlsIdentityDNSOnlyStop $fixture
    removeDirectory $emptyCApath
} -returnCodes error -match glob -result {*ssl connect failed:*}

set opensslHelp ""
if {[testConstraint tlsIdentityOpenSSLCLI]} {
    catch {exec {*}$::tlsIdentityOpenSSL s_server -help 2>@1} opensslHelp
}
set unixProbe ""
if {$::tcl_platform(platform) eq "unix" && [string match {*-unix *} $opensslHelp]} {
    catch {exec {*}$::tlsIdentityOpenSSL s_client -unix /ns-tls-nonexistent-[pid] -quiet < /dev/null 2>@1} unixProbe
}
testConstraint tlsIdentityUnix [expr {$::tcl_platform(platform) eq "unix"
                                    && [string match {*-unix *} $opensslHelp]
                                    && ![string match {*Operation not permitted*} $unixProbe]}]
foreach {name identity expected} {match localhost 200 mismatch not-in-certificate.example error} {
    test tls-identity-unix-$name {HTTPS Unix-domain transport still authenticates the target} \
        -constraints {tlsIdentityServer tlsIdentityOpenSSLCLI tlsIdentityUnix} -setup {
        set socketdir [ns_mkdtemp /tmp/ns-tls-XXXXXX]
        set socketpath [file join $socketdir tls.sock]
        set fixture {}
        set fixture {}
    set fixture [tlsIdentityDNSOnlyStart 127.0.0.1 $socketpath]
    } -body {
        set rc [catch {
            tlsIdentityRequest http -unix_socket $socketpath -hostname $identity \
                -cafile [file join [lindex $fixture 1] cert.pem]
        } value]
        if {$expected eq "error"} {
            list $rc [string match {*mismatch*} $value]
        } else {
            list $rc $value
        }
    } -cleanup {
        tlsIdentityDNSOnlyStop $fixture
        file delete -force $socketdir
    } -result [expr {$expected eq "error" ? {1 1} : {0 200}}]
}

rename tlsIdentityDNSOnlyStart {}
rename tlsIdentityDNSOnlyStop {}
rename tlsIdentityProxyStart {}
rename tlsIdentityProxyStop {}
rename tlsIdentityRequest {}
unset ::tlsIdentityOpenSSL
cleanupTests
