#
# Public-API checks use ns_connchan and local loopback sockets.
# Native sorting and resolver-order fallback are covered by developer/test-rfc6724-sort.sh.

package require tcltest 2.2
namespace import -force ::tcltest::*
::tcltest::configure {*}$argv

namespace eval ::rfc6724_test {
    variable connchans {}
    proc cleanup {} {
        variable connchans
        foreach channel $connchans {catch {ns_connchan close $channel}}
        set connchans {}
    }
    proc listener {address port marker} {
        variable connchans
        set callback [list apply {{marker channel} {
            ns_connchan write $channel $marker
            ns_connchan close $channel
            return 1
        }} $marker]
        set info [ns_connchan listen -bind $address $port $callback]
        lappend connchans [dict get $info channel]
        return $info
    }
    proc listen {} {
        set info [listener 127.0.0.1 0 4]
        return [list [dict get $info port] [dict get $info channel]]
    }
    proc client {host port {timeout 2s}} {
        variable connchans
        set channel [ns_connchan connect -timeout $timeout -- $host $port]
        lappend connchans $channel
        return $channel
    }
    proc receive {channel} {
        set deadline [expr {[clock milliseconds] + 2000}]
        while {[clock milliseconds] < $deadline} {
            set data [ns_connchan read $channel]
            if {$data ne ""} {return $data}
            after 5
        }
        error "timed out waiting for the listener marker"
    }
    proc connect {host local port {localPort 0}} {
        variable connchans
        set channel [ns_connchan connect -timeout 2s -localhost $local -localport $localPort -- $host $port]
        lappend connchans $channel
        return $channel
    }

}

set haveIPv6 false
if {[ns_info ipv6] && ![catch {
    ::rfc6724_test::listener ::1 0 6
    ns_addrbyhost ::1
}]} {set haveIPv6 true}
::rfc6724_test::cleanup
testConstraint rfc6724IPv6 $haveIPv6

test rfc6724-cold-connect {incremental candidates connect through ns_connchan} -body {
    lassign [::rfc6724_test::listen] port listener
    set channel [::rfc6724_test::client LoCALhOST $port]
    ::rfc6724_test::receive $channel
} -cleanup {::rfc6724_test::cleanup} -result 4

test rfc6724-warm-cache {connection sorting does not rewrite the combined DNS cache} -body {
    set host LoCAlHoST
    set before [ns_addrbyhost -all $host]
    lassign [::rfc6724_test::listen] port listener
    set channel [::rfc6724_test::client $host $port]
    list [expr {$before eq [ns_addrbyhost -all $host]}] \
        [expr {[ns_addrbyhost $host] eq [lindex $before 0]}] \
        [::rfc6724_test::receive $channel]
} -cleanup {::rfc6724_test::cleanup} -result {1 1 4}

test rfc6724-dual-ipv4 {a dual-family target remains usable with an IPv4 source} \
    -constraints rfc6724IPv6 -body {
    lassign [::rfc6724_test::listen] port listener
    set channel [::rfc6724_test::connect LOcalHoST 127.0.0.1 $port]
    ::rfc6724_test::receive $channel
} -cleanup {::rfc6724_test::cleanup} -result 4

test rfc6724-dual-ipv6 {a dual-family target remains usable with an IPv6 source} \
    -constraints rfc6724IPv6 -body {
    set info [::rfc6724_test::listener ::1 0 6]
    set port [dict get $info port]
    set channel [::rfc6724_test::connect lOCAlHoST ::1 $port]
    ::rfc6724_test::receive $channel
} -cleanup {::rfc6724_test::cleanup} -result 6

test rfc6724-connchan-ipv6 {IPv6 transfer uses NaviServer connection channels} \
    -constraints rfc6724IPv6 -body {
    set info [::rfc6724_test::listener ::1 0 6]
    set channel [::rfc6724_test::client ::1 [dict get $info port]]
    ::rfc6724_test::receive $channel
} -cleanup {::rfc6724_test::cleanup} -result 6

test rfc6724-localport {native-order fallback preserves the requested local TCP port} -returnCodes {ok error} -body {
    lassign [::rfc6724_test::listen] port listener
    set probe [::rfc6724_test::listener 127.0.0.1 0 4]
    set localPort [dict get $probe port]
    # An occupied source port must fail, proving -localport is honored.
    set code [catch {::rfc6724_test::connect LoCaLHosT 127.0.0.1 $port $localPort} message options]
    if {!$code} {error "connect unexpectedly ignored the occupied local port"}
    if {[dict get $options -errorcode] eq "NS_TIMEOUT"} {error "bind failure reported as timeout"}
    ns_connchan close [dict get $probe channel]
    set channel [::rfc6724_test::connect LoCaLHosT 127.0.0.1 $port $localPort]
    ::rfc6724_test::receive $channel
} -cleanup {::rfc6724_test::cleanup} -result 4

test rfc6724-localport-only {a local port can be bound without an explicit source address} -returnCodes {ok error} -body {
    lassign [::rfc6724_test::listen] port listener
    set probe [::rfc6724_test::listener 0.0.0.0 0 4]
    set localPort [dict get $probe port]
    set code [catch {ns_connchan connect -timeout 2s -localport $localPort -- 127.0.0.1 $port} message options]
    if {!$code} {
        lappend ::rfc6724_test::connchans $message
        error "connect unexpectedly ignored the occupied local port"
    }
    if {[dict get $options -errorcode] eq "NS_TIMEOUT"} {error "bind failure reported as timeout"}
    ns_connchan close [dict get $probe channel]
    set channel [ns_connchan connect -timeout 2s -localport $localPort -- 127.0.0.1 $port]
    lappend ::rfc6724_test::connchans $channel
    ::rfc6724_test::receive $channel
} -cleanup {::rfc6724_test::cleanup} -result 4

test rfc6724-repeated {repeated cache-hit connects release connection channels} -body {
    lassign [::rfc6724_test::listen] port listener
    set host LOcALHosT
    ns_addrbyhost -all $host
    set before [lsort [ns_connchan list]]
    for {set i 0} {$i < 12} {incr i} {
        set channel [::rfc6724_test::client $host $port]
        if {[::rfc6724_test::receive $channel] ne "4"} {error "wrong listener"}
        ns_connchan close $channel
        if {[ns_connchan exists $channel]} {error "connection channel leaked"}
    }
    expr {$before eq [lsort [ns_connchan list]]}
} -cleanup {::rfc6724_test::cleanup} -result 1

test rfc6724-zero-budget {address selection does not start TCP with a zero budget} -body {
    lassign [::rfc6724_test::listen] port listener
    set before [lsort [ns_connchan list]]
    set code [catch {::rfc6724_test::client lOCalHOST $port 0} message options]

    list $code [dict get $options -errorcode] [expr {$before eq [lsort [ns_connchan list]]}]
} -cleanup {::rfc6724_test::cleanup} -result {1 NS_TIMEOUT 1}

test rfc6724-source-family {an explicit source is not silently ignored for an incompatible destination} \
    -constraints rfc6724IPv6 -body {
    lassign [::rfc6724_test::listen] port listener
    set code [catch {::rfc6724_test::connect 127.0.0.1 ::1 $port} message options]
    list $code [expr {[dict get $options -errorcode] ne "NS_TIMEOUT"}]
} -cleanup {::rfc6724_test::cleanup} -result {1 1}

foreach localPort {-1 65536 invalid} {
    test rfc6724-invalid-port-$localPort {invalid local ports are rejected before connecting} -body {
        catch {ns_connchan connect -localport $localPort -- 127.0.0.1 1}
    } -result 1
}

namespace delete ::rfc6724_test
cleanupTests
