[include version_include.man]
[manpage_begin ns_baseunit n [vset version]]
[moddesc {NaviServer Built-in Commands}]

[titledesc {Convert time and memory-size units to seconds and bytes}]

[description]

[section {COMMANDS}]

[list_begin definitions]

[call [cmd ns_baseunit] \
        [opt [option "-size [arg memory-size]"]] \
        [opt [option "-time [arg time]"]] ]

[para] Convert a memory size to bytes or a time value to seconds, using
  the same NaviServer converters used by other commands. Fractional seconds
  are preserved. This lets Tcl commands accept uniform unit-bearing arguments,
  for example when calculating cache partition sizes from values such as 2MB.

[para] Either [option "-size [arg memory-size]"] or
  [option "-time [arg time]"] has to be specified.
  Valid time units are μs, ms, s, m, h, d, w, y.
  Valid size units are kB, MB, GB, KiB, MiB, GiB.

[list_end]

[section EXAMPLES]

[example_begin]
 % ns_baseunit -size 10KiB
 10240
 
 % ns_baseunit -time 2.5h
 9000

 % ns_baseunit -time 1500ms
 1.5
[example_end]


[keywords "global built-in" conversion time size unit]
[manpage_end]


